# 必填：需要申请证书的主域名。默认会申请 example.com 和 *.example.com。
DOMAIN=example.com

# Let's Encrypt 通知邮箱。
EMAIL=admin@example.com

# 可选：自定义完整证书域名列表，逗号分隔。
# CERTBOT_DOMAINS=*.domain.com,domain.com

# 推荐使用 API Token，只需要 Zone:DNS:Edit 权限。
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# 如果不用 API Token，也可以改用 Global API Key。
# 使用 Global API Key 时必须同时配置 CLOUDFLARE_EMAIL。
# CLOUDFLARE_EMAIL=you@example.com
# CLOUDFLARE_API_KEY=replace-with-cloudflare-global-api-key

CLOUDFLARE_PROPAGATION_SECONDS=60

# 每天 03:17 检查证书；Certbot 默认只会在证书接近过期时续期。
CERT_CRON=17 3 * * *

# 剩余多少天以内强制续期。Let's Encrypt 证书通常 90 天有效，建议 30-45。
RENEW_BEFORE_DAYS=30

RUN_ONCE=false
STAGING=true
